# Copy to .env and fill in. Generate APP_SECRET_KEY with: openssl rand -hex 32
APP_SECRET_KEY=change-me
IS_PRODUCTION=False
PORT=5000
DB_PATH=saas.db

# --- Auth0 (managed auth) ---
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# --- Stripe ---
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...           # your subscription Price ID
STRIPE_WEBHOOK_SECRET=whsec_...     # from `stripe listen` or the Dashboard webhook

# --- Email (SMTP, optional — for provisioning notifications) ---
MAIL_SERVER=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
